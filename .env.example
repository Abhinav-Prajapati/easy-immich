# Immich Settings
# The URL of your Immich instance (e.g. http://192.168.1.100:2283)
# Do not include a trailing slash.
IMMICH_URL=http://your-immich-ip:2283

# Your Immich API Key (generate one in Immich UI: Settings -> API Keys)
# Required permissions: asset.view, asset.download, server.about
IMMICH_API_KEY=your_immich_api_key_here

# Model & Processing Settings
# The DINOv2 model size to use.
# Options: small, base, large, giant
# - small:  384 dim, fast, works well on CPU
# - base:   768 dim, balanced (recommended)
# - large:  1024 dim, better accuracy, needs GPU
# - giant:  1536 dim, best, needs powerful GPU
DINO_MODEL=base

# The year of images to fetch and embed from Immich
TARGET_YEAR=2026

# Storage Settings
# Directory where ChromaDB will persist its database
CHROMA_PATH=./chroma_db

# Clustering Parameters
# Time gap threshold (in hours) to group photos into separate chronological events
TIME_THRESHOLD_HOURS=4.0

# DBSCAN visual clustering tolerance (lower is stricter, e.g. 0.15 for exact duplicates; 0.25 is recommended for scenes)
VISUAL_TOLERANCE_EPS=0.25

# DBSCAN min_samples parameter (1 ensures standalone photos are kept and not ignored)
MIN_SAMPLES=1

# Directory to download review clusters
OUTPUT_DIR=./review_clusters
